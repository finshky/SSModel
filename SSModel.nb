Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"scaled", " ", 
     RowBox[{"function", ":", 
      RowBox[{
       RowBox[{"E", "^", "z"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "z"}], "]"}]}]}]}], ",", 
    RowBox[{
    "evaluated", " ", "at", " ", "high", " ", "precision", " ", 
     "internally"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"G", "[", 
     RowBox[{"z_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", "z", "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"z", ",", "60"}], "]"}]}], "]"}]}]}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"should", " ", "be", " ", "equivalent", " ", "to", " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "z"}], "]"}]}], " ", "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T1", "[", 
     RowBox[{"\[Gamma]_", ",", "dt_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"G", "[", 
      RowBox[{"2", " ", "\[Gamma]"}], "]"}], "-", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "dt", " ", "\[Gamma]"}], "]"}], " ", 
      RowBox[{"G", "[", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "dt"}], ")"}], " ", "\[Gamma]"}], "]"}]}]}]}], "\n", 
   RowBox[{
    RowBox[{"T2", "[", 
     RowBox[{"\[Gamma]_", ",", "dt_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"G", "[", 
      RowBox[{"4", " ", "\[Gamma]"}], "]"}], "-", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "4"}], " ", "dt", " ", "\[Gamma]"}], "]"}], " ", 
      RowBox[{"G", "[", 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "dt"}], ")"}], " ", "\[Gamma]"}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"dt_", ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]_", ",", "r_"}], "}"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"dt", "+", 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "dt"}], ")"}], " ", "r", " ", "\[Gamma]", " ", 
        RowBox[{"T1", "[", 
         RowBox[{"\[Gamma]", ",", "dt"}], "]"}]}], "+", 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "dt"}], ")"}], " ", 
        RowBox[{"r", "^", "2"}], " ", "\[Gamma]", " ", 
        RowBox[{"T2", "[", 
         RowBox[{"\[Gamma]", ",", "dt"}], "]"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"dt", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "r"}], ")"}], "^", "2"}]}], ")"}]}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"f", "[", 
    RowBox[{"1.", ",", 
     RowBox[{"{", 
      RowBox[{"100.", ",", "10."}], "}"}]}], "]"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"works", ",", 
     RowBox[{"returns", " ", "a", " ", "machine", " ", "number"}]}], 
    "*)"}]}]}]], "Input",
