Cell[CellGroupData[{

Cell["Attempt at faster OmegaGW", "Subsection",
 CellChangeTimes->{{3.9990858888692837`*^9, 
  3.999085893911396*^9}},ExpressionUUID->"143d8d8f-5613-4f74-a526-\
88400bb5e355"],

Cell[BoxData["\[Zeta]k"], "Input",
 CellChangeTimes->{{3.999086320526709*^9, 
  3.999086321625334*^9}},ExpressionUUID->"a0290d70-3a6e-4d52-b524-\
6bd9c9746f8a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Pm", ",", "PM"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "OmegaGW2", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AccuracyGoal", "->", "\[Infinity]"}], ",", 
     RowBox[{"PrecisionGoal", "->", "3"}], ",", 
     RowBox[{"MaxRecursion", "->", "3"}], ",", 
     RowBox[{"\"\<RelativisticDOF\>\"", "->", "None"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"OmegaGW2", "[", 
   RowBox[{
    RowBox[{"K_", "?", "NumericQ"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"cs_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Delta]\[Tau]H_", "?", "NumericQ"}], ",", 
      RowBox[{"HR_", "?", "NumericQ"}]}], "}"}], ",", 
    RowBox[{"kinSpectrum", ":", 
     RowBox[{"(", 
      RowBox[{"_Association", "|", "_List"}], ")"}]}], ",", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\n", "\t", 
     RowBox[{
     "pref", ",", "\[Zeta]k", ",", "EkOverRstar", ",", "\[CapitalDelta]N", ",",
       "optsPref", ",", "optsInt"}], "\n", "\t", "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"EchoTiming", "[", 
      RowBox[{
       RowBox[{"optsPref", "=", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "OmegaGWPref", "]"}]}], "]"}]}], ";", "\n", 
       "\t", 
       RowBox[{"optsInt", "=", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "NIntegrate", "]"}]}], "]"}]}], ";", "\n", 
       "\t", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Zeta]k", ",", "EkOverRstar"}], "}"}], "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"kinSpectrum", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<KSpectrum\>\"", ",", "\"\<EkOverRstar\>\""}], "}"}]}],
          "]"}]}], ";", "\n", "\t", 
       RowBox[{"pref", "=", 
        RowBox[{"OmegaGWPref", "[", 
         RowBox[{"\[CapitalGamma]meanAdiabIndex", ",", "EkOverRstar", ",", 
          RowBox[{"optsPref", "//", "Evaluate"}]}], "]"}]}], ";", "\n", "\t", 
       
       RowBox[{
        RowBox[{"\[CapitalDelta]N", "[", 
         RowBox[{"p_", ",", "\[ScriptP]_"}], "]"}], ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "@", 
           RowBox[{"\[CapitalDelta]", "[", 
            RowBox[{"\[Delta]\[Tau]H", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"K", "/", "HR"}], ",", 
               RowBox[{"p", "/", "HR"}], ",", 
               RowBox[{"\[ScriptP]", "/", "HR"}], ",", "cs"}], "}"}]}], 
            "]"}]}], "//", "Simplify"}], "//", "Evaluate"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"OmegaGWIntegrand", "[", 
         RowBox[{
          RowBox[{"P_", "?", "NumericQ"}], ",", 
          RowBox[{"z_", "?", "NumericQ"}]}], "]"}], ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[ScriptCapitalP]", "=", 
              RowBox[{"Sqrt", "[", 
               RowBox[{
                RowBox[{"P", "^", "2"}], "+", 
                RowBox[{"K", "^", "2"}], "-", 
                RowBox[{"2", "P", " ", "K", " ", "z"}]}], "]"}]}], "}"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"z", "^", "2"}]}], ")"}], "^", "2"}], " ", 
             RowBox[{
              RowBox[{"P", "^", "2"}], "/", 
              RowBox[{"\[ScriptCapitalP]", "^", "4"}]}], " ", 
             RowBox[{"\[Zeta]k", "[", "P", "]"}], 
             RowBox[{"\[Zeta]k", "[", "\[ScriptCapitalP]", "]"}], 
             RowBox[{"\[CapitalDelta]N", "[", 
              RowBox[{"P", ",", "\[ScriptCapitalP]"}], "]"}]}]}], "]"}], "//",
           "Simplify"}], "//", "Evaluate"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"OmegaGWIntegrandP", "[", 
         RowBox[{"z_", "?", "NumericQ"}], "]"}], ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"OmegaGWIntegrand", "[", 
             RowBox[{"P", ",", "z"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"P", ",", "Pm", ",", "PM"}], "}"}], ",", "\n", "\t", 
            RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", "\n", 
            "\t", 
            RowBox[{"opts", "//", "Evaluate"}]}], "\n", "\t", "]"}], "//", 
          "Simplify"}], "//", "Evaluate"}]}], ";"}], "]"}], ";", "\n", "\t", 
     RowBox[{"pref", " ", 
      RowBox[{"K", "^", "3"}], " ", "\n", "\t", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"OmegaGWIntegrandP", "[", "z", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", 
          RowBox[{"-", ".999"}], ",", ".999"}], "}"}], ",", "\n", "\t\t", 
        RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}], ",", "\n", "\t\t", 
        
        RowBox[{"optsInt", "//", "Evaluate"}]}], "\n", "\t\t", "]"}]}]}]}], 
   "\n", "\t", "]"}]}]}], "Input",
 CellChangeTimes->{{3.999085939506041*^9, 3.999086115359387*^9}, {
  3.9990862388040667`*^9, 3.999086256969078*^9}, {3.999086325331661*^9, 
