Cell["Trapezoidal integral", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.996291375313923*^9, 3.996291384140512*^9}, 
   3.9962914914507217`*^9, 
