Cell[CellGroupData[{

Cell["Integration methods", "Section",
 CellChangeTimes->{{3.999335494647069*^9, 
  3.9993354971083603`*^9}},ExpressionUUID->"d117d1cf-34f0-454c-850a-\
adbecc3cb74d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"KK", "=", "1."}], ";"}]], "Input",
 CellChangeTimes->{{3.999335909852051*^9, 3.999335912229279*^9}, {
   3.9993359831598053`*^9, 3.9993359864711313`*^9}, {3.999336297900112*^9, 
   3.999336298454487*^9}, {3.999340098699559*^9, 3.9993401088866043`*^9}, 
   3.999605552507264*^9},
 CellLabel->
  "(K1) In[5]:=",ExpressionUUID->"2d115fce-9b7e-48cf-b4a9-b4ed969a7408"],

Cell[CellGroupData[{

Cell["Integral in P,\[ScriptCapitalP]", "Subsection",
 CellChangeTimes->{{3.9993355094490213`*^9, 
  3.999335516547172*^9}},ExpressionUUID->"5ef6b502-a7bd-4df9-b3e1-\
db258a026552"],

Cell[CellGroupData[{

Cell["Integral in \[ScriptCapitalP](P), then P", "Subsubsection",
 CellChangeTimes->{{3.9992606960809727`*^9, 
  3.999260706193675*^9}},ExpressionUUID->"3d556018-3cb4-4050-9def-\
4dc95b55fc1f"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "intP", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intP", "[", 
   RowBox[{"P_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KK", "^", "2"}], "+", 
            RowBox[{"P", "^", "2"}], "-", 
            RowBox[{"\[ScriptCapitalP]", "^", "2"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "P", " ", "KK"}], ")"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"z", "^", "2"}]}], ")"}], "^", "2"}], " ", "/", 
         RowBox[{"\[ScriptCapitalP]", "^", "3"}]}], " ", 
        RowBox[{"\[Zeta]k", "[", "\[ScriptCapitalP]", "]"}], 
        RowBox[{"\[CapitalDelta]", "[", 
         RowBox[{"\[Delta]\[Tau]H", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"KK", "/", "HR"}], ",", 
            RowBox[{"P", "/", "HR"}], ",", 
            RowBox[{"\[ScriptCapitalP]", "/", "HR"}], ",", "cs"}], "}"}]}], 
         "]"}]}]}], "]"}], "/.", "num"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[ScriptCapitalP]", ",", 
      RowBox[{"Abs", "[", 
       RowBox[{"KK", "-", "P"}], "]"}], ",", 
      RowBox[{"KK", "+", "P"}]}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Exclusions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"KK", "/", "cs"}], "-", "P"}], "}"}]}], ","}], "*)"}], 
    RowBox[{"AccuracyGoal", "->", "\[Infinity]"}], ",", 
    RowBox[{"PrecisionGoal", "->", "2"}], ",", 
    RowBox[{"MaxRecursion", "->", "\[Infinity]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.999170395048888*^9, 3.999170395492367*^9}, {
   3.999239629725041*^9, 3.999239666861726*^9}, {3.99923970861865*^9, 
