Cell[CellGroupData[{

Cell["2 Fluids", "Subsection",
 CellChangeTimes->{{3.9989914398911047`*^9, 
  3.9989914428931427`*^9}},ExpressionUUID->"198eefeb-7c66-43af-a291-\
943a212b7129"],

Cell[TextData[{
 " The spectrum implemented is the same as for 1 fluid, except for the \
\[OpenCurlyDoubleQuote]modified \[CapitalDelta] time integral\
\[CloseCurlyDoubleQuote]\n",
 Cell[BoxData[
  FormBox[Cell[TextData[Cell[BoxData[
    FormBox[Cell[TextData[Cell[BoxData[
      FormBox[Cell[TextData[Cell[BoxData[
        FormBox[
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[CapitalOmega]", "GW", 
            RowBox[{"2", "f"}]], "(", 
           RowBox[{
            SubscriptBox["\[Delta]\[Tau]", "fin"], ",", "K", ",", 
            RowBox[{"{", 
             RowBox[{"\[Gamma]", ",", 
              SubscriptBox["r", "w"]}], "}"}]}], ")"}], " ", "=", " ", 
          RowBox[{"3", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              OverscriptBox["w", "_"], 
              SubscriptBox[
               OverscriptBox["\[Rho]", "_"], "d"]], ")"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              SubscriptBox[
               OverscriptBox["\[Rho]", "_"], "d"], 
              SubscriptBox[
               OverscriptBox["\[Rho]", "_"], "tot"]], ")"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              SubsuperscriptBox["E", "kin", "*"], 
              SubscriptBox["R", "*"]], ")"}], "2"], 
           SuperscriptBox["K", "3"], 
           SubscriptBox["\[ScriptCapitalT]", "GW"], " ", 
           RowBox[{"(", 
            SubscriptBox["g", "*"], ")"}], "   ", 
           RowBox[{
            SubsuperscriptBox["\[Integral]", 
             RowBox[{"-", "1"}], "1"], 
            RowBox[{
             RowBox[{"\[DifferentialD]", "z"}], " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SuperscriptBox["z", "2"]}], ")"}], "2"], 
             RowBox[{
              SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
              RowBox[{"dp", " ", 
               FractionBox[
                SuperscriptBox["p", "2"], 
                RowBox[{
                 SuperscriptBox[
                  OverscriptBox["p", "~"], "4"], "(", 
                 RowBox[{"k", ",", "p", ",", "z"}], ")"}]], 
               RowBox[{
                SubscriptBox["\[Zeta]", "kin"], "(", "p", ")"}], 
               RowBox[{
                SubscriptBox["\[Zeta]", "kin"], "(", 
                OverscriptBox["p", "~"], ")"}], 
               StyleBox[
                RowBox[{
                 SuperscriptBox["\[CapitalDelta]", 
                  RowBox[{"2", "f"}]], "(", 
                 RowBox[{"\[Delta]\[Tau]", ",", "K", ",", "p", ",", 
                  OverscriptBox["p", "~"], ",", 
                  RowBox[{"{", 
                   RowBox[{"\[Gamma]", ",", 
                    SubscriptBox["r", "w"]}], "}"}]}], ")"}],
                FontColor->RGBColor[0.4, 0.6, 1]]}]}]}]}]}]}], 
         TraditionalForm]],ExpressionUUID->
        "2cea6171-e914-4c58-8c6c-9d0efda3c270"]],ExpressionUUID->
        "7f67be63-d6d2-4025-bac0-ddfe1c5bb110"], TraditionalForm]],
      ExpressionUUID->"62ff3075-8688-4ef7-a36e-fcb8663e641a"]],ExpressionUUID->
      "058c4cac-2eb5-45d4-b4c1-e8895138ec9a"], TraditionalForm]],
    ExpressionUUID->"d17b5122-1bda-41f6-853d-63304025e379"]],ExpressionUUID->
    "4702513f-576a-4550-bf1b-d833b34f430f"], TraditionalForm]],ExpressionUUID->
  "a2c5a93c-522c-491c-be37-911b21370c1f"]
}], "Text",
 CellChangeTimes->{{3.998991456786289*^9, 3.9989915125892563`*^9}, {
  4.000281601503533*^9, 
  4.0002816461240273`*^9}},ExpressionUUID->"202760b7-332b-4101-8ce1-\
