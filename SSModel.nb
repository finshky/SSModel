Cell[BoxData[
 TemplateBox[{
  "NIntegrate", "ncvb", 
   "\"NIntegrate failed to converge to prescribed accuracy after \
\\!\\(\\*RowBox[{\\\"9\\\"}]\\) recursive bisections in \
\\!\\(\\*RowBox[{\\\"SSModel`Private`P\\\"}]\\) near \\!\\(\\*RowBox[{\\\"{\\\
\", \\\"SSModel`Private`P\\\", \\\"}\\\"}]\\) = \\!\\(\\*RowBox[{\\\"{\\\", \
\\\"0.7067119361764769`\\\", \\\"}\\\"}]\\). NIntegrate obtained \
\\!\\(\\*RowBox[{\\\"2.834812707031348`*^-12\\\"}]\\) and \\!\\(\\*RowBox[{\\\
