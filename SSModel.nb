fd686a4d6626"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"z_", ",", "\[Xi]s_", ",", "vs_"}], "]"}], ":=", 
   RowBox[{"TrapezoidalIntegral", "[", 
    RowBox[{"\[Xi]s", ",", 
     RowBox[{
      FractionBox[
       RowBox[{"4", "\[Pi]"}], "z"], "vs", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"z", " ", "\[Xi]s"}], "]"}]}]}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"d\[Xi]s", ".", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"4", "\[Pi]"}], "z"], "vs", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"z", " ", "\[Xi]s"}], "]"}]}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "[", 
   RowBox[{"z_", ",", "\[Xi]s_", ",", "\[Lambda]s_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"flat", ",", "\[Xi]s2", ",", "\[Lambda]s2"}], "}"}], ",", 
    "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"\[Xi]s2", "=", 
      RowBox[{"\[Xi]s", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;", 
         RowBox[{"-", "3"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"\[Lambda]s2", "=", 
      RowBox[{"\[Lambda]s", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;", 
         RowBox[{"-", "3"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"flat", "=", 
      RowBox[{
       RowBox[{"\[Lambda]s", "[", 
        RowBox[{"[", "2", "]"}], "]"}], 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"z", " ", "\[Xi]"}], "]"}], "\[Xi]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Xi]", ",", "0", ",", 
           RowBox[{"\[Xi]s", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      FractionBox[
       RowBox[{"4", "\[Pi]"}], "z"], 
      RowBox[{"(", 
       RowBox[{"flat", "+", 
        RowBox[{"TrapezoidalIntegral", "[", 
         RowBox[{"\[Xi]s2", ",", 
          RowBox[{"\[Lambda]s2", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"z", " ", "\[Xi]s2"}], "]"}], "\[Xi]s2"}]}], "]"}]}], 
       ")"}]}]}]}], "\[IndentingNewLine]", "\t", "]"}]}]}], "Input",
