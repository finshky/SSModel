      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"FilterDataset", "[", 
         RowBox[{"file1f", ",", "a"}], "]"}], "]"}], ">", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Skipping \>\"", ",", "a"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Echo", "[", 
        RowBox[{"a", ",", "\"\<Computing\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gw", "=", 
        RowBox[{"ComputeOmegaGW", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"cs", ",", "\[Delta]\[Tau]H", ",", "HR"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"vw", ",", 
            RowBox[{"\[Alpha]", "/.", "num"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<DensityFraction\>\"", "->", "\[Rho]Frac"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<N\>\"", "->", "30"}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<Verbose\>\"", "->", "False"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<DynamicPlot\>\"", "->", "False"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<KRange\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"10.", "^", 
              RowBox[{"-", "3"}]}], ",", 
             RowBox[{"3", " ", 
              RowBox[{"10.", "^", "2"}]}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<Store\>\"", "->", "file1f"}]}], "\[IndentingNewLine]", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Echo", "[", 
        RowBox[{
         RowBox[{"StringRiffle", "[", 
          RowBox[{"{", 
           RowBox[{"vw", ",", "\[Delta]\[Tau]H", ",", "HR"}], "}"}], "]"}], ",", 
         RowBox[{"TimeObject", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
      "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"vw", ",", 
     RowBox[{"1.", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "9", ",", "2"}], "]"}], "/", "10"}]}]}], "}"}], ",",
    "\[IndentingNewLine]", 
