Cell[BoxData[
 RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<vw\>\"", "->", "vw"}], ",", 
       RowBox[{"\"\<SourceDuration\>\"", "->", "\[Delta]\[Tau]H"}], ",", 
       RowBox[{"\"\<HR\>\"", "->", "HR"}]}], "|>"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
