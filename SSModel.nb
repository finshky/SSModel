  RowBox[{
   RowBox[{
    RowBox[{"Log", "@", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KK", "^", "2"}], "+", 
            RowBox[{"E", "^", 
             RowBox[{"logP", "^", "2"}]}], "-", 
            RowBox[{"E", "^", 
             RowBox[{"log\[ScriptCapitalP]", "^", "2"}]}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", 
            RowBox[{"E", "^", "logP"}], " ", "KK"}], ")"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"z", "^", "2"}]}], ")"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"E", "^", "logP"}], "/", 
