Cell["Trapezoidal GW integration", "Section",
 CellChangeTimes->{{3.987602885192378*^9, 3.9876028897594833`*^9}, 
   3.987645225392873*^9},ExpressionUUID->"1537925e-50e8-456e-9e43-\
71438de08259"],

Cell["\<\
Works, but evaluations of the integrand are slow. Summation is direct\
\>", "Text",
 CellChangeTimes->{{3.987675159352063*^9, 
  3.98767522251012*^9}},ExpressionUUID->"bfa07bba-685c-4b83-b356-\
6c4384758363"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"trapezoid", " ", "integral", " ", "method"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TrapezoidalIntegral", "[", 
     RowBox[{"x_List", ",", "y_List"}], "]"}], ":=", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"Most", "[", "y", "]"}], "+", 
       RowBox[{"Rest", "[", "y", "]"}]}], "2"], ".", 
     RowBox[{"Differences", "[", "x", "]"}]}]}], "\n", 
   RowBox[{
    RowBox[{"TrapWeights", "[", "g_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"d", "=", 
        RowBox[{"Differences", "[", "g", "]"}]}], "}"}], ",", 
      RowBox[{".5", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"First", "@", "d"}], "}"}], ",", 
         RowBox[{
          RowBox[{"Most", "[", "d", "]"}], "+", 
          RowBox[{"Rest", "[", "d", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"Last", "@", "d"}], "}"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LogTrapWeights", "[", "g_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", "du"}], "}"}], ",", 
      RowBox[{
       RowBox[{"u", "=", 
        RowBox[{"Log", "[", "g", "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"du", "=", 
        RowBox[{"Differences", "[", "u", "]"}]}], ";", "\[IndentingNewLine]", 
       "\t", 
       RowBox[{"0.5", "g", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"First", "@", "du"}], "}"}], ",", 
          RowBox[{
           RowBox[{"Most", "[", "du", "]"}], "+", 
           RowBox[{"Rest", "[", "du", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"Last", "@", "du"}], "}"}]}], "]"}]}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TrapezoidalIntegralND", "[", 
     RowBox[{"grids_List", ",", "vals_"}], "]"}], ":=", 
    RowBox[{"Fold", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Inner", "[", 
        RowBox[{"Times", ",", "#1", ",", "#2", ",", "Plus"}], "]"}], "&"}], ",",
       "vals", ",", 
      RowBox[{"Reverse", "[", 
       RowBox[{"TrapWeights", "/@", "grids"}], "]"}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"LogTrapezoidalIntegralND", "[", 
     RowBox[{"grids_List", ",", "vals_"}], "]"}], ":=", 
    RowBox[{"Fold", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Inner", "[", 
        RowBox[{"Times", ",", "#1", ",", "#2", ",", "Plus"}], "]"}], "&"}], ",",
       "vals", ",", 
      RowBox[{"Reverse", "[", 
       RowBox[{"LogTrapWeights", "/@", "grids"}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"GeneralTrapezoidalIntegralND", "[", 
      RowBox[{"grids_List", ",", "vals_", ",", "types_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "weights", "}"}], ",", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"weights", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#2", "===", "\"\<Log\>\""}], ",", 
              RowBox[{"LogTrapWeights", "[", "#1", "]"}], ",", 
              RowBox[{"TrapWeights", "[", "#1", "]"}]}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"grids", ",", "types"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"Fold", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Inner", "[", 
            RowBox[{"Times", ",", "#1", ",", "#2", ",", "Plus"}], "]"}], 
           "&"}], ",", "vals", ",", 
          RowBox[{"Reverse", "[", "weights", "]"}]}], "]"}]}]}], "]"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GeneralTrapezoidalIntegralND", "[", 
     RowBox[{"grids_List", ",", "vals_", ",", "types_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "weights", "}"}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"weights", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#2", "===", "\"\<Log\>\""}], ",", 
              RowBox[{"LogTrapWeights", "[", "#1", "]"}], ",", 
              RowBox[{"TrapWeights", "[", "#1", "]"}]}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"grids", ",", "types"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"Fold", "[", 
        RowBox[{"Dot", ",", 
         RowBox[{"Developer`ToPackedArray", "[", "vals", "]"}], ",", 
         RowBox[{"Reverse", "[", "weights", "]"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LogTrapezoidalIntegral2D", "[", 
     RowBox[{"pGrid_List", ",", "qGrids_List", ",", "vals_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"wp", ",", "wq", ",", "inner"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wp", "=", 
        RowBox[{"LogTrapWeights", "[", "pGrid", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wq", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"LogTrapWeights", "[", "#", "]"}], "&"}], ",", "qGrids"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"inner", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Dot", ",", 
          RowBox[{"{", 
           RowBox[{"vals", ",", "wq"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wp", ".", "inner"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.987594156613781*^9, 3.987594156613801*^9}, {
