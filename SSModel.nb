Cell[CellGroupData[{
Cell["Sound Shell Model", "Title",
 CellChangeTimes->{{3.979281814857532*^9, 
  3.9792818173244553`*^9}},ExpressionUUID->"cfe81c26-e625-424b-9ebf-\
8c18575f0397"],

Cell[TextData[{
 "This notebook is a short tutorial for the ",
 ButtonBox["SSModel",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/finshky/SSModel"], None},
  ButtonNote->"https://github.com/finshky/SSModel"],
 " package, which computes gravitational wave spectra from acoustic \
oscillations following cosmological first-order phase transitions, based on \
the sound-shell model (",
 ButtonBox["JCAP12(2019)062",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://iopscience.iop.org/article/10.1088/1475-7516/2019/12/062"], 
    None},
  ButtonNote->
   "https://iopscience.iop.org/article/10.1088/1475-7516/2019/12/062"],
 ")."
}], "Text",
 CellChangeTimes->{{4.0020890083178053`*^9, 4.002089106220153*^9}, {
  4.0020891599110003`*^9, 4.0020892049226503`*^9}, {4.0026087053273287`*^9, 
  4.002608742721382*^9}},ExpressionUUID->"5a339b3c-0666-47b0-80f7-\
3b357d856a60"],

Cell[TextData[{
 "It includes ",
 StyleBox["SSModel_2f.wl", "Code"],
 ", an extension to the 2-fluid scenario, where sound waves from a phase \
transition in a dark sector \[OpenCurlyDoubleQuote]leak\
\[CloseCurlyDoubleQuote] into the visible sector."
}], "Text",
 CellChangeTimes->{{4.00208921123437*^9, 4.0020892270772667`*^9}, {
   4.002089373851272*^9, 4.002089405323072*^9}, {4.002089453756185*^9, 
