    RowBox[{"{", 
     RowBox[{
     "fp0_", ",", "z1_", ",", "z2_", ",", "a1_", ",", "a2_", ",", 
      "\[Gamma]_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox["fp0", "2"], 
   SuperscriptBox["z", "2"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["z", "z1"], ")"}], "a1"]}], ")"}], 
    FractionBox[
     RowBox[{"\[Gamma]", "-", "2"}], "a1"]], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["z", "z2"], ")"}], "a2"]}], ")"}], 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[Gamma]", "+", "4"}], "a2"]}]]}]}]}], "Input",
