f6e34d2a0949"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"num", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"vw", "->", ".9"}], ",", 
     RowBox[{"\[Alpha]", "->", ".1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Delta]\[Tau]H", "->", "1."}], ",", 
     RowBox[{"HR", "->", ".01"}], ",", "\[IndentingNewLine]", 
     RowBox[{"r", "->", "10."}], ",", 
     RowBox[{"\[Gamma]", "->", "10."}], ",", "\[IndentingNewLine]", 
     RowBox[{"k", "->", "1."}], ",", 
     RowBox[{"q", "->", ".1"}], ",", 
     RowBox[{"\[ScriptQ]", "->", ".2"}], ",", 
     RowBox[{"z", "->", ".3"}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
