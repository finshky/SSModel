Cell[BoxData[{
 RowBox[{
  RowBox[{"BPL", "[", 
   RowBox[{"z_", ",", 
    RowBox[{"{", 
     RowBox[{"fp0_", ",", "z1_", ",", "a1_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox["fp0", "2"], 
   SuperscriptBox["z", "2"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["z", "z1"], ")"}], "a1"]}], ")"}], 
    RowBox[{"-", 
     FractionBox["6", "a1"]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DBPL", "[", 
