     FormBox[Cell[TextData[Cell[BoxData[
       FormBox[
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalOmega]", "GW"], "(", 
          RowBox[{
           SubscriptBox["\[Delta]\[Tau]", "fin"], ",", "K"}], ")"}], " ", "=",
          " ", 
         RowBox[{"3", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             OverscriptBox["w", "_"], 
             SubscriptBox[
              OverscriptBox["\[Rho]", "_"], "d"]], ")"}], "2"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             SubscriptBox[
              OverscriptBox["\[Rho]", "_"], "d"], 
