Cell[BoxData[
 RowBox[{
  RowBox[{"Options", "[", "TrapezoidalIntegralK\[CapitalOmega]", "]"}], "=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"TrapezoidalIntegralK\[CapitalOmega]", "[", 
    RowBox[{"K_", ",", 
     RowBox[{"{", 
      RowBox[{"\[Delta]\[Tau]H_", ",", "\[Gamma]_", ",", "r_"}], "}"}], ",", 
     RowBox[{"fac_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "zs", ",", "Ps", ",", "\[CapitalDelta]HN", ",", "\[IndentingNewLine]", 
       RowBox[{"logPm", "=", 
        RowBox[{"-", "3.5"}]}], ",", 
       RowBox[{"logPM", "=", "3.5"}], ",", "P", ",", 
       RowBox[{"Kfac", "=", "10"}], ",", 
       RowBox[{"nfac", "=", 
        RowBox[{"fac", " ", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Log10", "[", "K", "]"}], ",", "1"}], "]"}]}]}]}], 
      RowBox[{"(*", 
       RowBox[{"Max", "[", 
        RowBox[{"1", ",", 
         RowBox[{"Log10", "[", "K", "]"}]}], "]"}], "*)"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"zs", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1", ",", 
         RowBox[{"Round", "[", 
          RowBox[{"nfac", " ", "100"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Log10", "[", "K", "]"}], "<", "logPm"}], " ", "\[Or]", " ", 
         RowBox[{
          RowBox[{"Log10", "[", "K", "]"}], ">", "logPM"}]}], ",", 
        RowBox[{
        "Print", "[", "\"\<!!K outside integration range!!\>\"", "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"Ps", "=", 
       RowBox[{"(*", 
        RowBox[{"10", "^", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"logPm", ",", "logPM", ",", 
           RowBox[{"fac", " ", "100"}]}], "]"}]}], "*)"}], 
       RowBox[{"10", "^", 
        RowBox[{"Join", "[", "\[IndentingNewLine]", "\t", 
         RowBox[{
          RowBox[{"Most", "@", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"logPm", ",", 
             RowBox[{"Log10", "[", 
              RowBox[{"K", "/", "Kfac"}], "]"}], ",", 
             RowBox[{"Round", "[", 
              RowBox[{"nfac", " ", "10"}], "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "\t", 
          RowBox[{"Most", "@", 
           RowBox[{"Subdivide", "[", 
            RowBox[{
             RowBox[{"Log10", "[", 
              RowBox[{"K", "/", "2"}], "]"}], ",", 
             RowBox[{"Log10", "[", 
              RowBox[{"Kfac", " ", "K"}], "]"}], ",", 
             RowBox[{"Round", "[", 
              RowBox[{"nfac", " ", "100"}], "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "\t", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"Log10", "[", 
             RowBox[{"2", "K"}], "]"}], ",", "logPM", ",", 
            RowBox[{"Round", "[", 
             RowBox[{"nfac", " ", "10"}], "]"}]}], "]"}]}], 
         "\[IndentingNewLine]", "\t", "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{
       RowBox[{"\[CapitalDelta]HN", "[", 
        RowBox[{"\"\<NLO1\>\"", ",", "p_", ",", "\[ScriptP]_"}], "]"}], ":=", 
       
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalDelta]H", "[", 
          RowBox[{"\"\<NLO1\>\"", ",", "\[Delta]\[Tau]H", ",", 
           RowBox[{"{", 
            RowBox[{
             FractionBox["K", "HR"], ",", 
             FractionBox["p", "HR"], ",", 
             FractionBox["\[ScriptP]", "HR"], ",", "cs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Gamma]", ",", "r"}], "}"}]}], "]"}], "//", 
         "Simplify"}], "//", "Evaluate"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"vals", "=", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalOmega]GWIntegrandHRNLONorm", "[", 
            RowBox[{"\[CapitalDelta]HN", ",", 
             RowBox[{"{", 
              RowBox[{"K", ",", "#2", ",", "#1"}], "}"}]}], "]"}], "&"}], ",",
           "zs", ",", "Ps"}], "]"}], "//", "EchoTiming"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"vals", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"NumericQ", "[", "#", "]"}], ",", "#", ",", "0."}], "]"}],
           "&"}], ",", "vals", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Depth", "[", "vals", "]"}], "-", "1"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"GeneralTrapezoidalIntegralND", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"zs", ",", "Ps"}], "}"}], ",", "vals", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "\t", "]"}]}]}]], "Input",
