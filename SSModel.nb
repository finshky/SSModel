      RowBox[{"{", 
       RowBox[{"\[Gamma]_", ",", "r_"}], "}"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"timeIntegrals", "[", "\"\<NLO2\>\"", "]"}], "//", "Re"}], "//",
      "Evaluate"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "evaluate", " ", "integral", " ", "on", " ", "the", " ", "support", "\[IndentingNewLine]",
       "If", " ", 
      RowBox[{"symmetric", ":", " ", 
       RowBox[{
        SubsuperscriptBox["\[Integral]", "1", "x"], 
        RowBox[{
         SubsuperscriptBox["\[Integral]", "1", "x"], 
         RowBox[{"f", 
          RowBox[{"(", 
           RowBox[{"x", ",", "y"}], ")"}], 
          RowBox[{"\[DifferentialD]", "x"}], 
          RowBox[{"\[DifferentialD]", "y"}]}]}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"F", "[", 
       RowBox[{"x", ",", "x"}], "]"}], "+", 
      RowBox[{"F", "[", 
       RowBox[{"1", ",", "1"}], "]"}], "-", 
      RowBox[{"2", 
       RowBox[{"F", "[", 
        RowBox[{"1", ",", "x"}], "]"}], "\[IndentingNewLine]", "This", " ", 
       "gives", " ", "numerical", " ", 
       RowBox[{"errors", "!!"}]}]}]}], "\[IndentingNewLine]", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EvaluateSupport", "[", 
     RowBox[{"F_", ",", "x_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"x", ",", "x"}], "]"}], "+", 
     RowBox[{"F", "[", 
      RowBox[{"1", ",", "1"}], "]"}], "-", 
     RowBox[{"2", 
      RowBox[{"F", "[", 
       RowBox[{"1", ",", "x"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]H", "[", 
     RowBox[{"\"\<NLO1\>\"", ",", 
      RowBox[{"\[Delta]\[Tau]H_", "?", "NumericQ"}], ",", 
      RowBox[{"{", 
