Cell[BoxData[{
 RowBox[{"ClearAll", "[", "intLogP", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intLogP", "[", 
   RowBox[{"logP_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"P", "=", 
          RowBox[{"E", "^", "logP"}]}], ",", 
         RowBox[{"\[ScriptCapitalP]", "=", 
          RowBox[{"E", "^", "log\[ScriptCapitalP]"}]}], ",", "z"}], "}"}], ",", 
       RowBox[{
        RowBox[{"z", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KK", "^", "2"}], "+", 
            RowBox[{"P", "^", "2"}], "-", 
            RowBox[{"\[ScriptCapitalP]", "^", "2"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "P", " ", "KK"}], ")"}]}]}], ";", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"z", "^", "2"}]}], ")"}], "^", "2"}], "/", 
          RowBox[{"\[ScriptCapitalP]", "^", "2"}]}], " ", 
         RowBox[{"\[Zeta]k", "[", "\[ScriptCapitalP]", "]"}], 
         RowBox[{"\[CapitalDelta]", "[", 
          RowBox[{"\[Delta]\[Tau]H", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"KK", "/", "HR"}], ",", 
             RowBox[{"P", "/", "HR"}], ",", 
             RowBox[{"\[ScriptCapitalP]", "/", "HR"}], ",", "cs"}], "}"}]}], 
          "]"}]}]}]}], "]"}], "/.", "num"}], ",", 
    RowBox[{"{", 
     RowBox[{"log\[ScriptCapitalP]", ",", 
      RowBox[{"Abs", "[", 
       RowBox[{"KK", "-", 
        RowBox[{"E", "^", "logP"}]}], "]"}], ",", 
      RowBox[{"KK", "+", 
       RowBox[{"E", "^", "logP"}]}]}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Exclusions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"KK", "/", "cs"}], "-", 
         RowBox[{"E", "^", "logP"}]}], "}"}]}], ","}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"AccuracyGoal", "->", "\[Infinity]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PrecisionGoal", "->", "2"}], ",", "\[IndentingNewLine]", 
    RowBox[{"MaxRecursion", "->", "\[Infinity]"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",ExpressionUUID->"94a11e51-99c1-475b-ba74-331aba393fbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KK", "^", "2"}], 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"With", "[", 
