Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalOmega]GWTrapezoidal", "[", 
   RowBox[{"K_", ",", 
    RowBox[{"fac_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"logPm", "=", 
       RowBox[{"-", "3.5"}]}], ",", 
      RowBox[{"logPM", "=", "3.5"}], ",", "P", ",", 
      RowBox[{"Kfac", "=", "10"}], ",", 
      RowBox[{"nfac", "=", 
       RowBox[{"fac", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Log10", "[", "K", "]"}], ",", "1"}], "]"}]}]}]}], 
     RowBox[{"(*", 
      RowBox[{"Max", "[", 
       RowBox[{"1", ",", 
        RowBox[{"Log10", "[", "K", "]"}]}], "]"}], "*)"}], "}"}], ",", 
    "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"z", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1", ",", 
        RowBox[{"Round", "[", 
         RowBox[{"nfac", " ", "100"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Log10", "[", "K", "]"}], "<", "logPm"}], " ", "\[Or]", " ", 
        
        RowBox[{
         RowBox[{"Log10", "[", "K", "]"}], ">", "logPM"}]}], ",", 
       RowBox[{
       "Print", "[", "\"\<!!K outside integration range!!\>\"", "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"P", "=", 
      RowBox[{"10", "^", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"logPm", ",", "logPM", ",", 
         RowBox[{"fac", " ", "100"}]}], "]"}]}]}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Most", "@", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"logKm", ",", 
             RowBox[{"Log10", "[", 
              RowBox[{"K", "/", "Kfac"}], "]"}], ",", 
             RowBox[{"Round", "[", 
              RowBox[{"nfac", " ", "10"}], "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"Most", "@", 
           RowBox[{"Subdivide", "[", 
            RowBox[{
             RowBox[{"Log10", "[", 
              RowBox[{"K", "/", "2"}], "]"}], ",", 
             RowBox[{"Log10", "[", 
              RowBox[{"Kfac", " ", "K"}], "]"}], ",", 
             RowBox[{"Round", "[", 
              RowBox[{"nfac", " ", "100"}], "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"Log10", "[", 
             RowBox[{"2", "K"}], "]"}], ",", "logKM", ",", 
            RowBox[{"Round", "[", 
             RowBox[{"nfac", " ", "10"}], "]"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"vals", "=", 
        RowBox[{
         RowBox[{"\[CapitalOmega]GWPref", "[", 
          RowBox[{
          "\[CapitalGamma]meanAdiabIndex", ",", "1.", ",", "EkOverRstar"}], 
          "]"}], 
         SuperscriptBox["K", "3"], 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalOmega]GWIntegrandHR", "[", 
             RowBox[{"\[Delta]\[Tau]H", ",", 
              RowBox[{"{", 
               RowBox[{"K", ",", "#2", ",", "#1", ",", "cs"}], "}"}], ",", 
              "HR", ",", 
              RowBox[{"{", 
               RowBox[{"100.", ",", "10."}], "}"}]}], "]"}], "&"}], ",", "z", 
           ",", "P"}], "]"}]}]}]}], "*)"}], ";", "\[IndentingNewLine]", "\t", 
     
     RowBox[{"vals", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"NumericQ", "[", "#", "]"}], ",", "#", ",", "0."}], "]"}], 
         "&"}], ",", "vals", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Depth", "[", "vals", "]"}], "-", "1"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", "\t", 
     RowBox[{"GeneralTrapezoidalIntegralND", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z", ",", "P"}], "}"}], ",", "vals", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\t", "]"}]}]], "Input",
