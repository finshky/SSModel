Cell[CellGroupData[{

Cell["Compute time integrals", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.996296187838429*^9, 3.996296200363978*^9}, 
   3.997182465429215*^9},ExpressionUUID->"4de47c3a-1033-4a5f-a800-\
7639cb7af1a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"compute", " ", "and", " ", "store", " ", "integrals"}], " ", 
   "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"intNLO1", "=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Integral]", 
        RowBox[{"\[Integral]", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"\[Tau]H1", " ", "\[Tau]H2"}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"TrigReduce", "[", " ", 
              RowBox[{
               RowBox[{"Cos", "[", 
                RowBox[{"K", 
                 RowBox[{"(", 
                  RowBox[{"\[Tau]H2", "-", "\[Tau]H1"}], ")"}]}], "]"}], 
               RowBox[{"Cos", "[", 
                RowBox[{"q", " ", "c", " ", 
                 RowBox[{"(", 
                  RowBox[{"\[Tau]H2", "-", "\[Tau]H1"}], ")"}]}], "]"}], 
               RowBox[{"Sin", "[", 
                RowBox[{"\[ScriptQ]", " ", "c", " ", 
                 RowBox[{"(", 
                  RowBox[{"\[Tau]H2", "-", "\[Tau]H1"}], ")"}]}], "]"}]}], 
              "]"}], "/.", 
             RowBox[{
              RowBox[{"Cos", "[", "x_", "]"}], ":>", 
              RowBox[{"Cos", "[", 
               RowBox[{"Simplify", "[", "x", "]"}], "]"}]}]}], "//", 
            "Evaluate"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "2"}], "\[Gamma]", " ", 
              RowBox[{"(", 
               RowBox[{"\[Tau]H2", "-", "1"}], ")"}]}]], "-", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "2"}], "\[Gamma]", " ", 
              RowBox[{"(", 
               RowBox[{"\[Tau]H1", "-", "1"}], ")"}]}]]}], ")"}], 
          RowBox[{"\[DifferentialD]", "\[Tau]H1"}], 
          RowBox[{"\[DifferentialD]", "\[Tau]H2"}]}]}]}], "//", "Simplify"}], 
      "//", "EchoTiming"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intNLO2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Integral]", 
        RowBox[{"\[Integral]", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"\[Tau]H1", " ", "\[Tau]H2"}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"TrigReduce", "[", " ", 
              RowBox[{
               RowBox[{"Cos", "[", 
                RowBox[{"K", 
                 RowBox[{"(", 
                  RowBox[{"\[Tau]H2", "-", "\[Tau]H1"}], ")"}]}], "]"}], 
               RowBox[{"Cos", "[", 
                RowBox[{"q", " ", "c", " ", 
                 RowBox[{"(", 
                  RowBox[{"\[Tau]H2", "-", "\[Tau]H1"}], ")"}]}], "]"}], 
               RowBox[{"Cos", "[", 
                RowBox[{"\[ScriptQ]", " ", "c", " ", 
                 RowBox[{"(", 
                  RowBox[{"\[Tau]H2", "-", "\[Tau]H1"}], ")"}]}], "]"}]}], 
              "]"}], "/.", 
             RowBox[{
              RowBox[{"Cos", "[", "x_", "]"}], ":>", 
              RowBox[{"Cos", "[", 
               RowBox[{"Simplify", "[", "x", "]"}], "]"}]}]}], "//", 
            "Evaluate"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "2"}], "\[Gamma]", " ", 
              RowBox[{"(", 
               RowBox[{"\[Tau]H2", "-", "1"}], ")"}]}]], "+", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "2"}], "\[Gamma]", " ", 
              RowBox[{"(", 
               RowBox[{"\[Tau]H1", "-", "1"}], ")"}]}]], "+", 
            RowBox[{"2", "r", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "2"}], "\[Gamma]", 
               RowBox[{"(", 
                RowBox[{"\[Tau]H1", "+", "\[Tau]H2", "-", "2"}], ")"}]}]]}]}],
            ")"}], 
          RowBox[{"\[DifferentialD]", "\[Tau]H1"}], 
          RowBox[{"\[DifferentialD]", "\[Tau]H2"}]}]}]}], "//", "Simplify"}], 
      "//", "EchoTiming"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<NLO1\>\"", "->", "intNLO1"}], ",", 
      RowBox[{"\"\<NLO2\>\"", "->", "intNLO2"}]}], "|>"}], 
    ">>", "\"\<timeIndefiniteIntegrals.m\>\""}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IntNLO1", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"intNLO1", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Tau]H1", "->", 
             RowBox[{"1", "+", "\[CapitalDelta]\[Tau]H"}]}], ",", 
            RowBox[{"\[Tau]H2", "->", 
             RowBox[{"1", "+", "\[CapitalDelta]\[Tau]H"}]}]}], "}"}]}], ")"}],
         "+", 
        RowBox[{"(", 
         RowBox[{"intNLO1", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Tau]H1", "->", "1"}], ",", 
            RowBox[{"\[Tau]H2", "->", "1"}]}], "}"}]}], ")"}], "-", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"intNLO1", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Tau]H1", "->", "1"}], ",", 
             RowBox[{"\[Tau]H2", "->", 
              RowBox[{"1", "+", "\[CapitalDelta]\[Tau]H"}]}]}], "}"}]}], 
          ")"}]}]}], "//", "Re"}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IntNLO2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"intNLO2", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Tau]H1", "->", 
            RowBox[{"1", "+", "\[CapitalDelta]\[Tau]H"}]}], ",", 
           RowBox[{"\[Tau]H2", "->", 
            RowBox[{"1", "+", "\[CapitalDelta]\[Tau]H"}]}]}], "}"}]}], ")"}], 
       "+", 
       RowBox[{"(", 
        RowBox[{"intNLO2", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Tau]H1", "->", "1"}], ",", 
           RowBox[{"\[Tau]H2", "->", "1"}]}], "}"}]}], ")"}], "-", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"intNLO2", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Tau]H1", "->", "1"}], ",", 
            RowBox[{"\[Tau]H2", "->", 
             RowBox[{"1", "+", "\[CapitalDelta]\[Tau]H"}]}]}], "}"}]}], 
         ")"}]}]}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<NLO1\>\"", "->", "IntNLO1"}], ",", 
      RowBox[{"\"\<NLO2\>\"", "->", "IntNLO2"}]}], "|>"}], 
    ">>", "\"\<timeIntegrals.m\>\""}], " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]HArg", "[", 
     RowBox[{"\"\<NLO1\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]H1_", ",", "\[Tau]H2_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"K_", ",", "q_", ",", "\[ScriptQ]_", ",", "c_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]_", ",", "r_"}], "}"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"timeIntegrals", "[", "\"\<NLO1\>\"", "]"}], "//", "Re"}], "//",
      "Evaluate"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]HArg", "[", 
     RowBox[{"\"\<NLO2\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]H1_", ",", "\[Tau]H2_"}], "}"}], ",", 
