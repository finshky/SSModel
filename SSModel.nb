              OverscriptBox["\[Rho]", "_"], "tot"]], ")"}], "2"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             SubsuperscriptBox["E", "kin", "*"], 
             SubscriptBox["R", "*"]], ")"}], "2"], 
          SubscriptBox["\[ScriptCapitalT]", "GW"], " ", 
          RowBox[{"(", 
           SubscriptBox["g", "*"], ")"}], " ", 
          SuperscriptBox["K", "3"], "  ", 
          RowBox[{
           SubsuperscriptBox["\[Integral]", 
            RowBox[{"-", "1"}], "1"], 
           RowBox[{
            RowBox[{"\[DifferentialD]", "z"}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox["z", "2"]}], ")"}], "2"], 
            RowBox[{
             SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
             RowBox[{"dp", " ", 
              FractionBox[
               SuperscriptBox["p", "2"], 
               RowBox[{
                SuperscriptBox[
                 OverscriptBox["p", "~"], "4"], "(", 
                RowBox[{"k", ",", "p", ",", "z"}], ")"}]], 
              RowBox[{
               SubscriptBox["\[Zeta]", "kin"], "(", "p", ")"}], 
              RowBox[{
               SubscriptBox["\[Zeta]", "kin"], "(", 
