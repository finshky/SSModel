9dfc29c55bc2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "w"], "\[Congruent]", 
    FractionBox[
     SubscriptBox[
      OverscriptBox["w", "_"], "v"], 
     SubscriptBox[
      OverscriptBox["w", "_"], "d"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "964d7525-fed9-488c-9d79-5cf25f474c13"],
 " the enthalpy ratio between the visible and dark fluids."
