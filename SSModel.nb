Cell[TextData[{
 "GetKineticSpecrum\[LineSeparator]Get the kinetic spectrum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Zeta]", "kin"], "(", "K", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "072a759f-82fa-4e6d-912c-507f7fb2d639"],
 " (Eqs. 33 and 41 of ",
 ButtonBox["2308.12943",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/2308.12943"], None},
  ButtonNote->"https://arxiv.org/pdf/2308.12943"],
 "). \[LineSeparator]If not in ",
 StyleBox["kinetic.wl",
  FontSlant->"Italic"],
 ", compute and store the relative spectrum.",
 " "
}], "Item",
 CellChangeTimes->{{4.002089536932807*^9, 4.0020895961964273`*^9}, {
  4.002089740886208*^9, 4.0020897579390287`*^9}, {4.002089836934422*^9, 
  4.002089897535141*^9}},ExpressionUUID->"1b863c79-4559-4ee2-90a9-\
91f8c118a473"],

Cell[TextData[{
 "OmegaGW\[LineSeparator]The gravitational wave spectrum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "GW"], "(", "K", ")"}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "c06322e8-0ff3-49ac-8298-a4d36e17015f"],
 " (Eq. 51 of ",
 ButtonBox["2308.12943",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/2308.12943"], None},
  ButtonNote->"https://arxiv.org/pdf/2308.12943"],
