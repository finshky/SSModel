          RowBox[{"{", 
           RowBox[{
            RowBox[{"KK", "/", "HR"}], ",", 
            RowBox[{
             RowBox[{"E", "^", "logP"}], "/", "HR"}], ",", 
            RowBox[{
             RowBox[{"E", "^", "log\[ScriptCapitalP]"}], "/", "HR"}], ",", 
            "cs"}], "}"}]}], "]"}]}]}], "]"}]}], "/.", "num"}], ",", 
   RowBox[{"{", 
