Cell[BoxData[{
 RowBox[{"ClearAll", "[", "intLogP", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intLogP", "[", 
   RowBox[{"logP_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"P", "=", 
          RowBox[{"E", "^", "logP"}]}], ",", 
         RowBox[{"\[ScriptCapitalP]", "=", 
          RowBox[{"E", "^", "log\[ScriptCapitalP]"}]}], ",", "z"}], "}"}], ",", 
       RowBox[{
        RowBox[{"z", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KK", "^", "2"}], "+", 
            RowBox[{"P", "^", "2"}], "-", 
            RowBox[{"\[ScriptCapitalP]", "^", "2"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "P", " ", "KK"}], ")"}]}]}], ";", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"z", "^", "2"}]}], ")"}], "^", "2"}], "/", 
          RowBox[{"\[ScriptCapitalP]", "^", "2"}]}], " ", 
         RowBox[{"\[Zeta]k", "[", "\[ScriptCapitalP]", "]"}], 
         RowBox[{"\[CapitalDelta]", "[", 
          RowBox[{"\[Delta]\[Tau]H", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"KK", "/", "HR"}], ",", 
             RowBox[{"P", "/", "HR"}], ",", 
             RowBox[{"\[ScriptCapitalP]", "/", "HR"}], ",", "cs"}], "}"}]}], 
          "]"}]}]}]}], "]"}], "/.", "num"}], ",", 
    RowBox[{"{", 
     RowBox[{"log\[ScriptCapitalP]", ",", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"KK", "-", 
          RowBox[{"E", "^", "logP"}]}], "]"}], "]"}], "/.", 
       RowBox[{"Indeterminate", "->", 
        RowBox[{"-", "\[Infinity]"}]}]}], ",", 
      RowBox[{"Log", "[", 
       RowBox[{"KK", "+", 
        RowBox[{"E", "^", "logP"}]}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AccuracyGoal", "->", "\[Infinity]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PrecisionGoal", "->", "2"}], ",", "\[IndentingNewLine]", 
    RowBox[{"MaxRecursion", "->", "\[Infinity]"}]}], "\[IndentingNewLine]", 
