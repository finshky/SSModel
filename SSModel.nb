Cell[TextData[{
 "GetKineticSpecrum\[LineSeparator]Get the kinetic spectrum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Zeta]", "kin"], "(", "K", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "072a759f-82fa-4e6d-912c-507f7fb2d639"],
