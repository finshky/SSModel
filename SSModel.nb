         RowBox[{"OptionValue", "[", "\"\<DynamicPlot\>\"", "]"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
