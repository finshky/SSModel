  4.002089968001336*^9}},ExpressionUUID->"415f8297-a1c5-45ed-9146-\
f40acbf74e49"],

Cell[CellGroupData[{

Cell["\<\
OmegaGW2f\[LineSeparator]The 2-fluid gravitational wave spectrum (Eq. 45 of \
arXiv xx.yy).\[LineSeparator]Two additional parameters govern this spectrum:\
\>", "Item",
 CellChangeTimes->{{4.002089561608471*^9, 4.0020895644598703`*^9}, {
  4.002089952900898*^9, 
  4.002090045855805*^9}},ExpressionUUID->"3fc4e18e-bcaa-4d02-ba2c-\
1ce9f2cbc196"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[Congruent]", 
    FractionBox[
     SubscriptBox["\[CapitalGamma]", "int"], 
     SubscriptBox["H", "*"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab3bd9f0-9864-442d-a5b0-598140c93bdb"],
 " the interaction rate between the two fluids, normalized to the Hubble \
parameter at the transition time."
}], "Subitem",
 CellChangeTimes->{{4.002089561608471*^9, 4.0020895644598703`*^9}, {
  4.002089952900898*^9, 
  4.002090101097828*^9}},ExpressionUUID->"45dff227-9ca1-41e9-8b03-\
9dfc29c55bc2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "w"], "\[Congruent]", 
    FractionBox[
     SubscriptBox[
      OverscriptBox["w", "_"], "v"], 
     SubscriptBox[
      OverscriptBox["w", "_"], "d"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "964d7525-fed9-488c-9d79-5cf25f474c13"],
 " the enthalpy ratio between the visible and dark fluids."
}], "Subitem",
 CellChangeTimes->{{4.002089561608471*^9, 4.0020895644598703`*^9}, {
  4.002089952900898*^9, 
  4.002090151349947*^9}},ExpressionUUID->"eeba5275-8e4f-422d-90be-\
