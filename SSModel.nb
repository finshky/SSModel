Cell[CellGroupData[{

Cell["2 Fluids", "Subsection",
 CellChangeTimes->{{3.9989914398911047`*^9, 
  3.9989914428931427`*^9}},ExpressionUUID->"198eefeb-7c66-43af-a291-\
943a212b7129"],

Cell[TextData[{
 " The spectrum implemented is the same as for 1 fluid, except for the \
\[OpenCurlyDoubleQuote]modified \[CapitalDelta] time integral\
\[CloseCurlyDoubleQuote]\n",
 Cell[BoxData[
  FormBox[Cell[TextData[Cell[BoxData[
    FormBox[Cell[TextData[Cell[BoxData[
      FormBox[Cell[TextData[Cell[BoxData[
        FormBox[
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[CapitalOmega]", "GW", 
            RowBox[{"2", "f"}]], "(", 
           RowBox[{
            SubscriptBox["\[Delta]\[Tau]", "fin"], ",", "K", ",", 
            RowBox[{"{", 
             RowBox[{"\[Gamma]", ",", 
              SubscriptBox["r", "w"]}], "}"}]}], ")"}], " ", "=", " ", 
          RowBox[{"3", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              OverscriptBox["w", "_"], 
              SubscriptBox[
               OverscriptBox["\[Rho]", "_"], "d"]], ")"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              SubscriptBox[
