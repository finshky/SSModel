Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"integrand", "[", 
   RowBox[{"logP_", ",", "log\[ScriptCapitalP]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"P", "=", 
       RowBox[{"E", "^", "logP"}]}], ",", 
      RowBox[{"\[ScriptCapitalP]", "=", 
       RowBox[{"E", "^", "log\[ScriptCapitalP]"}]}], ",", "z"}], "}"}], ",", 
    RowBox[{
     RowBox[{"z", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"KK", "^", "2"}], "+", 
         RowBox[{"P", "^", "2"}], "-", 
         RowBox[{"\[ScriptCapitalP]", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "P", " ", "KK"}], ")"}]}]}], ";", 
     RowBox[{"Log", "@", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"z", "^", "2"}]}], ")"}], "^", "2"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"P", "/", "\[ScriptCapitalP]"}], ")"}], "^", "2"}], 
         RowBox[{"\[Zeta]k", "[", "P", "]"}], " ", 
         RowBox[{"\[Zeta]k", "[", "\[ScriptCapitalP]", "]"}], 
         RowBox[{"\[CapitalDelta]", "[", 
          RowBox[{"\[Delta]\[Tau]H", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"KK", "/", "HR"}], ",", 
             RowBox[{"P", "/", "HR"}], ",", 
             RowBox[{"\[ScriptCapitalP]", "/", "HR"}], ",", "cs"}], "}"}]}], 
          "]"}]}], "/.", "num"}], "]"}]}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"integrand", "[", 
    RowBox[{"logP", ",", "log\[ScriptCapitalP]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"logP", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"log\[ScriptCapitalP]", ",", "1", ",", "3"}], "}"}], ",", 
   RowBox[{"AspectRatio", "->", "1"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"logP", ",", "log\[ScriptCapitalP]", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"KK", "-", 
         RowBox[{"E", "^", "logP"}]}], "]"}], "<", "log\[ScriptCapitalP]", "<", 
       RowBox[{"KK", "+", 
        RowBox[{"E", "^", "logP"}]}]}]}], "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.999336388843897*^9, 3.999336446327471*^9}, {
  3.999340369682494*^9, 3.999340493761097*^9}, {3.99934057336474*^9, 
