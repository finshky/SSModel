Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fp0", "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"4", "\[Pi]"}], "3"]}], 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Xi]", "3"], 
       RowBox[{"vip", "[", "\[Xi]", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Xi]", ",", "\[Xi]m", ",", "\[Xi]M"}], "}"}]}], "]"}]}]}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"fInt", "'"}], "[", "zm", "]"}], "/", "zm"}], " ", "*)"}]}], "\n", 
 RowBox[{"l0", "=", 
  RowBox[{"4", "\[Pi]", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Lambda]ip", "[", "\[Xi]", "]"}], " ", 
      SuperscriptBox["\[Xi]", "2"]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Xi]", ",", "\[Xi]m", ",", "\[Xi]M"}], "}"}]}], 
    "]"}]}]}]}], "Input",
 CellLabel->
  "(K1) In[47]:=",ExpressionUUID->"375aaea0-13ff-4d4c-9e1b-7665223884c7"],

