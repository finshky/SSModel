Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[Congruent]", 
    FractionBox[
     SubscriptBox["\[CapitalGamma]", "int"], 
     SubscriptBox["H", "*"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab3bd9f0-9864-442d-a5b0-598140c93bdb"],
 " the interaction rate between the two fluids, normalized to the Hubble \
parameter at the transition time."
}], "Subitem",
