Cell[BoxData[
 RowBox[{
  RowBox[{"OmegaGW", "[", 
   RowBox[{
    RowBox[{"K_", "?", "NumericQ"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"cs_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Delta]\[Tau]H_", "?", "NumericQ"}], ",", 
      RowBox[{"HR_", "?", "NumericQ"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"vw_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Alpha]_", "?", "NumericQ"}]}], "}"}], ",", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\n", "\t", 
     RowBox[{
     "pref", ",", "kinSpectrum", ",", "\[Zeta]k", ",", "EkOverRstar", ",", 
      "\[CapitalDelta]HN", ",", "\n", "\t", "optsKin", ",", "optsPref", ",", 
      "optsInt"}], "\n", "\t", "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"optsKin", "=", 
      RowBox[{
       RowBox[{"FilterRules", "[", 
        RowBox[{"opts", ",", 
         RowBox[{"Options", "[", "GetKineticSpectrum", "]"}]}], "]"}], "//", 
       "Evaluate"}]}], ";", "\n", "\t", 
     RowBox[{"optsPref", "=", 
      RowBox[{
       RowBox[{"FilterRules", "[", 
        RowBox[{"opts", ",", 
         RowBox[{"Options", "[", "OmegaGWPref", "]"}]}], "]"}], "//", 
       "Evaluate"}]}], ";", "\n", "\t", 
     RowBox[{"optsInt", "=", 
      RowBox[{"FilterRules", "[", 
       RowBox[{"opts", ",", 
        RowBox[{"Options", "[", "NIntegrate", "]"}]}], "]"}]}], ";", "\n", 
     "\t", 
     RowBox[{"kinSpectrum", "=", 
      RowBox[{"GetKineticSpectrum", "[", 
       RowBox[{"vw", ",", "\[Alpha]", ",", "cs", ",", 
        RowBox[{"optsKin", "//", "Evaluate"}]}], "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Zeta]k", ",", "EkOverRstar"}], "}"}], "=", 
      RowBox[{"Lookup", "[", 
       RowBox[{"kinSpectrum", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<KSpectrum\>\"", ",", "\"\<EkOverRstar\>\""}], "}"}]}], 
       "]"}]}], ";", "\n", "\t", 
     RowBox[{"pref", "=", 
      RowBox[{"OmegaGWPref", "[", 
       RowBox[{"\[CapitalGamma]meanAdiabIndex", ",", "EkOverRstar", ",", 
        RowBox[{"optsPref", "//", "Evaluate"}]}], "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"\[CapitalDelta]HN", "[", 
       RowBox[{"p_", ",", "\[ScriptP]_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "@", 
         RowBox[{"\[CapitalDelta]", "[", 
          RowBox[{"\[Delta]\[Tau]H", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"K", "/", "HR"}], ",", 
             RowBox[{"p", "/", "HR"}], ",", 
             RowBox[{"\[ScriptP]", "/", "HR"}], ",", "cs"}], "}"}]}], "]"}]}],
         "//", "Simplify"}], "//", "Evaluate"}]}], ";", "\n", "\t", 
     RowBox[{"pref", " ", 
      RowBox[{"K", "^", "3"}], " ", "\n", "\t", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"EchoTiming", "[", 
         RowBox[{"OmegaGWIntegrandP", "[", 
          RowBox[{"\[Zeta]k", ",", "\[CapitalDelta]HN", ",", 
           RowBox[{"{", 
            RowBox[{"K", ",", "z"}], "}"}], ",", "optsInt"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", 
          RowBox[{"-", ".999"}], ",", ".999"}], "}"}], ",", "\n", "\t\t", 
        RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}], ",", "\n", "\t\t", 
        
        RowBox[{"optsInt", "//", "Evaluate"}]}], "\n", "\t\t", "]"}]}]}]}], 
   "\n", "\t", "]"}]}]], "Input",ExpressionUUID->"11f21ca7-4f8e-4850-897b-\
3b5c858ce5a5"]
}, Open  ]]
